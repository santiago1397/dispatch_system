
# agents_bots - Production Environment
# Generated by fastapi-fullstack v0.1.14
#
# IMPORTANT: Copy this file to .env.prod before deploying
#   cp .env.prod.example .env.prod
#
# WARNING: Never commit .env.prod to version control!

# === Container Prefix (must be unique per server) ===
CONTAINER_PREFIX=agents_bots

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # Generate: openssl rand -base64 32
POSTGRES_DB=agents_bots

# === JWT Secret ===
SECRET_KEY=  # Generate: openssl rand -hex 32

# === LLM: fallback provider (OpenAI) ===
# Always required. When LLM_PROVIDER=minimax this is the FALLBACK, used
# when MiniMax errors, rate-limits, times out, or returns low confidence.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1
AI_BASE_URL=https://api.openai.com/v1

# === LLM: primary provider (MiniMax) — optional ===
# LLM_PROVIDER selects which provider serves structured extraction FIRST.
#   openai  (default) — single provider; identical to the previous behaviour
#   minimax           — MiniMax primary, OpenAI automatic fallback
# Flipping to minimax with an empty MINIMAX_API_KEY logs a warning and
# keeps serving from OpenAI rather than failing.
#
# Verify before flipping:  make llm-smoke
LLM_PROVIDER=openai
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1
